# Copy this file to .env and change the values.

# Database connection
DB_NAME=vokie
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only on the server (with DJANGO_DEBUG=0), see README.md
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vocaboo.me
# DJANGO_HSTS_SECONDS=3600
# DJANGO_SECURE_SSL_REDIRECT=1

# Emails (codes of new accounts, forgotten password); without VOCABOO_EMAIL_HOST and with
# DJANGO_DEBUG=1 they are printed to the console. Gmail: see README.md
# VOCABOO_EMAIL_HOST=smtp.gmail.com
# VOCABOO_EMAIL_PORT=587
# VOCABOO_EMAIL_USER=vocaboo.app@gmail.com
# VOCABOO_EMAIL_PASSWORD=abcdabcdabcdabcd
# VOCABOO_EMAIL_FROM=Vocaboo <vocaboo.app@gmail.com>

# Registration asks for this code (empty = anybody can sign up)
# VOCABOO_REGISTRATION_CODE=
