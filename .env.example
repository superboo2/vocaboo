# Copy this file to .env and change the values.

# Database connection
DB_NAME=vokie
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

