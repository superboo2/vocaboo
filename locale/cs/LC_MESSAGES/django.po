msgid ""
"The language you translate your words into. It is filled in for a new deck."
msgstr ""
"Jazyk, do kterého si slovíčka překládáš. Předvyplní se u nového slovníku."

msgid "App language"
msgstr "Jazyk aplikace"

msgid "Default test direction"
msgstr "Výchozí směr testu"

msgid "Suggest translations"
msgstr "Navrhovat překlad"

