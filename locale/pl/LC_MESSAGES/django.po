msgstr "Słowniczek „%(name)s” utworzony."

msgid "Create"
msgstr "Utwórz"

#, python-format
msgid "Added %(count)s word to “%(deck)s”."
msgid_plural "Added %(count)s words to “%(deck)s”."
msgstr[0] "Dodano %(count)s słówko do „%(deck)s”."
msgstr[1] "Dodano %(count)s słówka do „%(deck)s”."
msgstr[2] "Dodano %(count)s słówek do „%(deck)s”."
msgstr[3] "Dodano %(count)s słówka do „%(deck)s”."

msgid "Tick the words you want to add."
msgstr "Zaznacz słówka, które chcesz dodać."

msgid "Changes saved."
msgstr "Zmiany zapisane."

msgid "Deck moved."
msgstr "Słowniczek przeniesiony."

msgid "Move deck"
msgstr "Przenieś słowniczek"

#, python-format
msgid ""
"Only decks with the same languages where the tree fits are offered (at most "
"%(max)d levels)."
msgstr ""
"Proponowane są tylko słowniczki z tymi samymi językami, w których zmieści "
"się drzewo (najwyżej %(max)d poziomów)."

#, python-format
msgid "Deck “%(name)s” deleted (decks: %(decks)d, words: %(terms)d)."
msgstr ""
"Słowniczek „%(name)s” usunięty (słowniczki: %(decks)d, słówka: %(terms)d)."

msgid "Could not tell where to move the deck. Try again."
msgstr ""
"Nie udało się ustalić, dokąd przenieść słowniczek. Spróbuj jeszcze raz."

msgid "Word added."
msgstr "Słówko dodane."

msgid "The word could not be added, check the form."
msgstr "Nie udało się dodać słówka, sprawdź formularz."

msgid "Report updated."
msgstr "Zgłoszenie zaktualizowane."

msgid "Thanks, the mistake is reported."
msgstr "Dzięki, błąd został zgłoszony."

#, python-format
msgid "Added: %(word)s → %(native)s"
msgstr "Dodano: %(word)s → %(native)s"

msgid "Choose at least one word."
msgstr "Wybierz co najmniej jedno słówko."

#, python-format
msgid "%(count)s word"
msgid_plural "%(count)s words"
msgstr[0] "%(count)s słówko"
msgstr[1] "%(count)s słówka"
msgstr[2] "%(count)s słówek"
msgstr[3] "%(count)s słówka"

#, python-format
msgid "Also added to “%(deck)s”: %(words)s."
msgstr "Dodano też do „%(deck)s”: %(words)s."

#, python-format
msgid "Moved to “%(deck)s”: %(words)s."
msgstr "Przeniesiono do „%(deck)s”: %(words)s."

#, python-format
msgid "Already there: %(count)d."
msgstr "Już tam były: %(count)d."

#, python-format
msgid "Word “%(word)s” deleted."
msgstr "Słówko „%(word)s” usunięte."

#, python-format
msgid "Word “%(word)s” removed from this deck."
msgstr "Słówko „%(word)s” usunięte z tego słowniczka."

#, python-format
msgid "Saved for later: %(word)s"
msgstr "Zapisano na później: %(word)s"

#, python-format
msgid "Deleted: %(word)s"
msgstr "Usunięto: %(word)s"
